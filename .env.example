# Copy this file to .env.local for local development, and add the same
# three variables in Vercel → Project → Settings → Environment Variables.
#
# All three are optional: without them the site still works and shows the
# leadership list from src/config/club.ts; only the /admin portal is disabled.
# See supabase/README.md for where to find each value.

# Supabase → Project Settings → Data API → Project URL
SUPABASE_URL=

# Supabase → Project Settings → API Keys → "Publishable key" (or legacy "anon" key)
SUPABASE_ANON_KEY=

# Supabase → Project Settings → API Keys → "Secret key" (or legacy "service_role" key)
# SECRET: never share it, never commit it, never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
